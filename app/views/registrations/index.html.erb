<div class="container mt-4">
  <h1>Registrations</h1>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>User</th>
        <th>Event</th>
        <th>Status</th>
        <th>Date</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @registrations.each do |registration| %>
        <tr>
          <td><%= registration.user.name %></td>
          <td><%= link_to registration.event.name, registration.event %></td>
          <td>
            <span class="badge bg-<%= registration.confirmed? ? 'success' : registration.waitlisted? ? 'warning' : registration.cancelled? ? 'danger' : 'secondary' %>">
              <%= registration.status.capitalize %>
            </span>
          </td>
          <td><%= registration.created_at.strftime("%B %d, %Y") %></td>
          <td>
            <%= link_to "Cancel", registration, data: { turbo_method: :delete, turbo_confirm: "Cancel this registration?" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>