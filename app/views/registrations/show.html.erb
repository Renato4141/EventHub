<div class="container mt-4">
  <h1>Registration</h1>
  <p><strong>User:</strong> <%= @registration.user.name %></p>
  <p><strong>Event:</strong> <%= link_to @registration.event.name, @registration.event %></p>
  <p><strong>Status:</strong> <%= @registration.status.capitalize %></p>
  <p><strong>Date:</strong> <%= @registration.created_at.strftime("%B %d, %Y") %></p>

  <div class="mt-3">
    <%= link_to "Cancel Registration", @registration, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
    <%= link_to "Back to Registrations", registrations_path, class: "btn btn-secondary" %>
  </div>
</div>