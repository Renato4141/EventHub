<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><%= @event.name %></h1>
    <span class="badge bg-<%= @event.published? ? 'success' : @event.draft? ? 'secondary' : 'dark' %> fs-6">
      <%= @event.status.capitalize %>
    </span>
  </div>

  <div class="row">
    <div class="col-md-8">
      <p><strong>Description:</strong></p>
      <div><%= @event.description %></div>

      <hr>

      <p><strong>Date:</strong> <%= @event.date.strftime("%B %d, %Y %H:%M") %></p>
      <p><strong>Location:</strong> <%= @event.location %></p>
      <p><strong>Capacity:</strong> <%= @event.capacity %></p>
      <p><strong>Available spots:</strong> <%= @event.capacity - @event.registrations.where(status: [:confirmed, :pending]).count %></p>
      <p><strong>Organizer:</strong> <%= @event.user.name %></p>

      <% if @event.venue.present? %>
        <p><strong>Venue:</strong> <%= link_to @event.venue.name, @event.venue %></p>
        <p><strong>Venue address:</strong> <%= @event.venue.address %></p>
      <% end %>

      <% if @event.categories.any? %>
        <p><strong>Categories:</strong>
          <% @event.categories.each do |cat| %>
            <span class="badge bg-info text-dark"><%= cat.name %></span>
          <% end %>
        </p>
      <% end %>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Registrations</h5>
          <p>Confirmed: <%= @event.registrations.confirmed.count %></p>
          <p>Waitlisted: <%= @event.registrations.waitlisted.count %></p>

          <% if @event.published? %>
            <%= button_to "Register", registrations_path, method: :post,
                params: { registration: { event_id: @event.id } },
                class: "btn btn-success w-100" %>
          <% else %>
            <button class="btn btn-secondary w-100" disabled>Registration unavailable</button>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <hr>

  <div class="mt-3">
    <%= link_to "Edit", edit_event_path(@event), class: "btn btn-warning" %>
    <%= link_to "Cancel Event", @event, data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to cancel this event?" }, class: "btn btn-danger" %>
    <%= link_to "Back to Events", events_path, class: "btn btn-secondary" %>
  </div>

  <hr>

  <h3>Reviews</h3>
  <% if @event.reviews.any? %>
    <% @event.reviews.each do |review| %>
      <div class="card mb-2">
        <div class="card-body">
          <p><strong><%= review.user.name %></strong>  <%= review.rating %>/5</p>
          <p><%= review.comment %></p>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-muted">No reviews yet.</p>
  <% end %>
</div>