<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Categories</h1>
    <%= link_to "New Category", new_category_path, class: "btn btn-primary" %>
  </div>

  <% if @categories.empty? %>
    <p class="text-muted">No categories yet.</p>
  <% else %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td><%= link_to category.name, category %></td>
            <td>
              <%= link_to "Edit", edit_category_path(category), class: "btn btn-sm btn-warning" %>
              <%= link_to "Delete", category, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>