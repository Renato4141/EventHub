<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Events</h1>
    <%= link_to "New Event", new_event_path, class: "btn btn-primary" %>
  </div>

  <% if @events.empty? %>
    <p class="text-muted">No events yet.</p>
  <% else %>
    <div class="row">
      <% @events.each do |event| %>
        <div class="col-md-4 mb-4">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title"><%= link_to event.name, event %></h5>
              <p class="card-text text-muted"><%= event.start_date.strftime("%B %d, %Y") %></p>
              <p class="card-text"><%= event.location %></p>
              <span class="badge bg-<%= event.published? ? 'success' : event.draft? ? 'secondary' : 'dark' %>">
                <%= event.status.capitalize %>
              </span>
            </div>
            <div class="card-footer">
              <%= link_to "View", event, class: "btn btn-sm btn-outline-primary" %>
              <%= link_to "Edit", edit_event_path(event), class: "btn btn-sm btn-warning" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>