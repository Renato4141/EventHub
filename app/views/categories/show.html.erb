<div class="container mt-4">
  <h1><%= @category.name %></h1>

  <div class="mt-3">
    <%= link_to "Edit", edit_category_path(@category), class: "btn btn-warning" %>
    <%= link_to "Delete", @category, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
    <%= link_to "Back to Categories", categories_path, class: "btn btn-secondary" %>
  </div>
</div>