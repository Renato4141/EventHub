<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Venues</h1>
    <%= link_to "New Venue", new_venue_path, class: "btn btn-primary" %>
  </div>

  <% if @venues.empty? %>
    <p class="text-muted">No venues yet.</p>
  <% else %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Address</th>
          <th>Capacity</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @venues.each do |venue| %>
          <tr>
            <td><%= link_to venue.name, venue %></td>
            <td><%= venue.address %></td>
            <td><%= venue.capacity || "-" %></td>
            <td>
              <%= link_to "Edit", edit_venue_path(venue), class: "btn btn-sm btn-warning" %>
              <%= link_to "Delete", venue, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>