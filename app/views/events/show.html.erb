<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><%= @event.name %></h1>
    
    <span class="badge bg-<%= 
      case @event.status
      when 'published' then 'success'
      when 'ongoing'   then 'info'
      when 'finished'  then 'dark'
      when 'cancelled' then 'danger'
      else 'secondary'
      end
    %> fs-6">
      <%= @event.status.to_s.capitalize %>
    </span>
  </div>

  <div class="row">
    <div class="col-md-8">
      <p><strong>Description:</strong></p>
      <div><%= @event.description %></div>

      <hr>

      <p><strong>Start Date:</strong> <%= @event.start_date&.strftime("%B %d, %Y %H:%M") %></p>
      <p><strong>End Date:</strong> <%= @event.end_date&.strftime("%B %d, %Y %H:%M") || "Not set" %></p>
      <p><strong>Capacity:</strong> <%= @event.capacity %></p>
      <p><strong>Available spots:</strong> <%= @event.available_spots %></p>
      <p><strong>Organizer:</strong> <%= link_to @event.user.name, user_path(@event.user) %></p>

      <% if @event.venue.present? %>
        <p><strong>Venue:</strong> <%= link_to @event.venue.name, @event.venue %></p>
        <p><strong>Venue address:</strong> <%= @event.venue.address %></p>
      <% end %>

      <% if @event.categories.any? %>
        <p><strong>Categories:</strong>
          <% @event.categories.each do |cat| %>
            <span class="badge bg-info text-dark"><%= cat.name %></span>
          <% end %>
        </p>
      <% end %>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Registrations</h5>
          <p>Confirmed: <%= @event.registrations.confirmed.count %></p>
          <p>Waitlisted: <%= @event.registrations.waitlisted.count %></p>

          <% if user_signed_in? %>
            <% if @event.published? %>
              <% if @event.full? %>
                <div class="alert alert-warning p-2 text-center mb-2" style="font-size: 0.85rem;">
                  Event is full. Register to join the waitlist.
                </div>
                <%= button_to "Join Waitlist", registrations_path, method: :post,
                    params: { registration: { event_id: @event.id } },
                    class: "btn btn-warning w-100" %>
              <% else %>
                <%= button_to "Register", registrations_path, method: :post,
                    params: { registration: { event_id: @event.id } },
                    class: "btn btn-success w-100" %>
              <% end %>
            <% else %>
              <button class="btn btn-secondary w-100" disabled>Registration unavailable</button>
              <p class="text-muted mt-2 text-center" style="font-size: 0.85rem;">
                Currently <%= @event.status %>.
              </p>
            <% end %>

            <% user_reg = @event.registrations.find_by(user: current_user) %>
            <% if user_reg && !user_reg.cancelled? %>
              <hr>
              <p class="text-muted" style="font-size: 0.85rem;">
                Your status: <strong><%= user_reg.status.capitalize %></strong>
              </p>
              <%= button_to "Cancel Registration", registration_path(user_reg), method: :delete,
                  data: { turbo_confirm: "Cancel your registration?" },
                  class: "btn btn-outline-danger w-100 mt-1" %>
            <% end %>
          <% else %>
            <hr>
            <p class="text-muted text-center" style="font-size: 0.85rem;">
              <%= link_to "Log in", new_user_session_path %> to register for this event.
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <hr>

  <% if user_signed_in? && (current_user == @event.user || current_user.admin?) %>
    <div class="mt-3 d-flex gap-2">
      <%= link_to "Edit", edit_event_path(@event), class: "btn btn-warning" %>
      
      <% if @event.draft? %>
        <%= button_to "Publish Event", event_path(@event), method: :patch, 
            params: { event: { status: 'published' } }, 
            class: "btn btn-success" %>
      <% end %>

      <% if @event.draft? || @event.published? %>
        <%= button_to "Cancel Event", event_path(@event), method: :patch, 
            params: { event: { status: 'cancelled' } }, 
            data: { turbo_confirm: "Are you sure you want to cancel this event?" }, 
            class: "btn btn-danger" %>
      <% end %>
    </div>
    <hr>
  <% end %>

  <h3>Reviews</h3>

  <% if user_signed_in? %>
    <% if @event.finished? %>
      <% if @event.registrations.exists?(user: current_user, status: :confirmed) %>
        <% if @event.reviews.exists?(user: current_user) %>
          <div class="alert alert-success">
            You have already reviewed this event. Thank you for your feedback!
          </div>
        <% else %>
          <div class="card mb-4">
            <div class="card-body">
              <h5 class="card-title">Leave a Review</h5>
              <%= form_with model: Review.new, url: reviews_path, data: { turbo: false } do |f| %>
                <%= f.hidden_field :event_id, value: @event.id %>

                <div class="mb-3">
                  <%= f.label :rating, class: "form-label" %>
                  <%= f.select :rating, options_for_select([["5 Stars", 5], ["4 Stars", 4], ["3 Stars", 3], ["2 Stars", 2], ["1 Star", 1]]), {}, class: "form-select" %>
                </div>

                <div class="mb-3">
                  <%= f.label :comment, class: "form-label" %>
                  <%= f.text_area :comment, rows: 3, class: "form-control", placeholder: "Share your experience..." %>
                </div>

                <%= f.submit "Submit Review", class: "btn btn-primary" %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-muted">Only confirmed attendees can leave a review.</p>
      <% end %>
    <% elsif @event.published? || @event.ongoing? %>
      <p class="text-muted">Reviews will open once the event is completed.</p>
    <% end %>
  <% else %>
    <p class="text-muted"><%= link_to "Log in", new_user_session_path %> to leave a review.</p>
  <% end %>

  <% if @event.reviews.any? %>
    <% @event.reviews.each do |review| %>
      <div class="card mb-2">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong><%= review.user.name %></strong>
            <span class="badge bg-warning text-dark"><%= review.rating %> / 5 </span>
          </div>
          <p class="mb-0"><%= review.comment %></p>
          
          <% if user_signed_in? && (current_user == review.user || current_user.admin?) %>
            <div class="mt-2 text-end">
              <%= button_to "Delete Review", review_path(review), method: :delete, data: { turbo_confirm: "Delete your review?" }, class: "btn btn-sm btn-outline-danger" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-muted mt-3">No reviews yet.</p>
  <% end %>
</div>