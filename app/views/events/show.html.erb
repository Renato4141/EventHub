<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><%= @event.name %></h1>
    
    <%# 1. Etiqueta dinámica para los 5 estados posibles del evento %>
    <span class="badge bg-<%= 
      case @event.status
      when 'published' then 'success'
      when 'ongoing'   then 'info'
      when 'finished'  then 'dark'
      when 'cancelled' then 'danger'
      else 'secondary' # draft
      end
    %> fs-6">
      <%= @event.status.to_s.capitalize %>
    </span>
  </div>

  <div class="row">
    <div class="col-md-8">
      <p><strong>Description:</strong></p>
      <div><%= @event.description %></div>

      <hr>

      <p><strong>Start Date:</strong> <%= @event.start_date.strftime("%B %d, %Y %H:%M") %></p>
      <p><strong>End Date:</strong> <%= @event.end_date.strftime("%B %d, %Y %H:%M") %></p>
      <p><strong>Location:</strong> <%= @event.location %></p>
      <p><strong>Capacity:</strong> <%= @event.capacity %></p>
      <p><strong>Available spots:</strong> <%= @event.available_spots %></p>
      <p><strong>Organizer:</strong> <%= @event.user.name %></p>

      <% if @event.venue.present? %>
        <p><strong>Venue:</strong> <%= link_to @event.venue.name, @event.venue %></p>
        <p><strong>Venue address:</strong> <%= @event.venue.address %></p>
      <% end %>

      <% if @event.categories.any? %>
        <p><strong>Categories:</strong>
          <% @event.categories.each do |cat| %>
            <span class="badge bg-info text-dark"><%= cat.name %></span>
          <% end %>
        </p>
      <% end %>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Registrations</h5>
          <%# Solo mostramos confirmed y waitlisted, cancelled se mantiene interno %>
          <p>Confirmed: <%= @event.registrations.confirmed.count %></p>
          <p>Waitlisted: <%= @event.registrations.waitlisted.count %></p>

          <%# 2. El registro SOLO se permite si el evento está "published" %>
          <% if @event.published? %>
            <% if @event.full? %>
              <div class="alert alert-warning p-2 text-center mb-2" style="font-size: 0.85rem;">
                Event is full. Register to join the waitlist.
              </div>
              <%= button_to "Join Waitlist", registrations_path, method: :post,
                  params: { registration: { event_id: @event.id } },
                  class: "btn btn-warning w-100" %>
            <% else %>
              <%= button_to "Register", registrations_path, method: :post,
                  params: { registration: { event_id: @event.id } },
                  class: "btn btn-success w-100" %>
            <% end %>
          <% else %>
            <%# Bloqueado para draft, ongoing, finished y cancelled %>
            <button class="btn btn-secondary w-100" disabled>Registration unavailable</button>
            <p class="text-muted mt-2 text-center" style="font-size: 0.85rem;">
              Currently <%= @event.status %>.
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <hr>

  <%# 3. Lógica del Organizador %>
  <div class="mt-3 d-flex gap-2">
    <%= link_to "Edit", edit_event_path(@event), class: "btn btn-warning" %>
    
    <%# Solo se puede publicar si es un borrador %>
    <% if @event.draft? %>
      <%= button_to "Publish Event", event_path(@event), method: :patch, 
          params: { event: { status: 'published' } }, 
          class: "btn btn-success" %>
    <% end %>

    <%# Solo se puede cancelar un borrador o un evento publicado (no los finished ni ongoing) %>
    <% if @event.draft? || @event.published? %>
      <%= button_to "Cancel Event", event_path(@event), method: :patch, 
          params: { event: { status: 'cancelled' } }, 
          data: { turbo_confirm: "Are you sure you want to cancel this event?" }, 
          class: "btn btn-danger" %>
    <% end %>

    <%= link_to "Back to Events", events_path, class: "btn btn-secondary" %>
  </div>

  <hr>

  <h3>Reviews</h3>
  <% if @event.reviews.any? %>
    <% @event.reviews.each do |review| %>
      <div class="card mb-2">
        <div class="card-body">
          <p><strong><%= review.user.name %></strong>  <%= review.rating %>/5</p>
          <p><%= review.comment %></p>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-muted">No reviews yet.</p>
  <% end %>
</div>