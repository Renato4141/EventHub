<%= form_with model: event, local: true do |f| %>
  <% if event.errors.any? %>
    <div class="alert alert-danger">
      <% event.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "Title", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", placeholder: "Event title", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.rich_text_area :description, class: "form-control" %>
  </div>

  <div class="row">
    <div class="row mb-3">
      <div class="col-md-6">
        <%= f.label :start_date, "Start Date", class: "form-label" %>
        <%= f.datetime_local_field :start_date, class: "form-control", required: true %>
      </div>
      
      <div class="col-md-6">
        <%= f.label :end_date, "End Date", class: "form-label" %>
        <%= f.datetime_local_field :end_date, class: "form-control", required: true %>
      </div>
    </div>
    
    <div class="col-md-6 mb-3">
      <%= f.label :capacity, class: "form-label" %>
      <%= f.number_field :capacity, class: "form-control", placeholder: "Max attendees", min: 1, required: true %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :location, class: "form-label" %>
    <%= f.text_field :location, class: "form-control", placeholder: "City or address" %>
  </div>

  <div class="mb-3">
    <%= f.label :venue_id, "Venue", class: "form-label" %>
    <%= f.collection_select :venue_id, Venue.all, :id, :name, { include_blank: "-- Select a venue --" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.label :category_ids, "Categories", class: "form-label" %>
    <%= f.collection_check_boxes :category_ids, Category.all, :id, :name do |b| %>
      <div class="form-check form-check-inline">
        <%= b.check_box class: "form-check-input" %>
        <%= b.label class: "form-check-label" %>
      </div>
    <% end %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>